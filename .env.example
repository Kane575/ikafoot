# Copiez ce fichier vers .env puis remplissez les valeurs.
# .env ne doit JAMAIS être commité (il est déjà dans .gitignore).

# --- Base de données ---------------------------------------------------------
# Local  : postgresql://postgres:motdepasse@localhost:5432/ikafoot
# Neon   : postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/ikafoot?sslmode=require
# Render : la chaîne "Internal Database URL" du dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ikafoot

# --- Sécurité ----------------------------------------------------------------
# Signe le cookie de session admin. Générez-en un avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# --- Compte propriétaire (utilisé par `npm run db:seed`) ---------------------
ADMIN_PHONE=76733749
ADMIN_PASSWORD=
ADMIN_NAME=Propriétaire IKAFOOT

# --- Tarifs appliqués par `npm run db:seed` (FCFA) ---------------------------
DEFAULT_WEEKDAY_PRICE=25000
DEFAULT_WEEKEND_PRICE=30000

# --- Acompte -----------------------------------------------------------------
# La moitié du prix est due d'avance pour confirmer une réservation.
# Numéro sur lequel le client envoie l'acompte (mobile money).
# S'il est vide, ADMIN_PHONE est utilisé.
PAYMENT_PHONE=
# Combien d'heures le créneau reste bloqué sans acompte (défaut : 2).
BOOKING_HOLD_HOURS=2

# --- Serveur -----------------------------------------------------------------
PORT=3002

# N'ajoutez PAS NODE_ENV ici. Vite lit ce fichier au moment du build : un
# NODE_ENV=development y embarquerait la version développement de React dans
# le build de production (2,3× plus lourde, avec les avertissements de debug).
# En local, son absence suffit — le serveur ne se met en mode production que
# si NODE_ENV vaut exactement « production », ce que fait l'hébergeur.
